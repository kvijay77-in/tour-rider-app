# ============================================================================
# Subscription Mode Configuration
# ============================================================================
# Options: 'single' or 'multi'
# - single: Default and recommended. App is tied to one organizer at build time.
# - multi: Future/advanced SaaS mode that uses invitation-based organizer discovery.
# Default: single
EXPO_PUBLIC_SUBSCRIPTION_MODE=single

# ============================================================================
# Single Subscription Mode Configuration
# ============================================================================
# Required when SUBSCRIPTION_MODE=single
# Single-subscription mode only requires the Cognito and API values below.
# Organizer metadata is optional and used only for labels/logging.

# Organizer Identification (optional)
EXPO_PUBLIC_ORGANIZER_ID=<your-organizer-id>
EXPO_PUBLIC_ORGANIZER_NAME=<your-organizer-name>

# AWS Cognito Configuration
# Dedicated Cognito User Pool for the organizer's riders
EXPO_PUBLIC_AWS_USER_POOL_ID=<your-cognito-user-pool-id>
EXPO_PUBLIC_AWS_USER_POOL_WEB_CLIENT_ID=<your-cognito-client-id>
EXPO_PUBLIC_AWS_IDENTITY_POOL_ID=<your-cognito-identity-pool-id>

# API Configuration
# Base URL for the organizer's tour-data-api instance (without trailing slash)
EXPO_PUBLIC_TOUR_DATA_API_BASE_URL=<your-tour-data-api-base-url>

# ============================================================================
# Multi Subscription Mode Configuration
# ============================================================================
# When SUBSCRIPTION_MODE=multi, the above AWS and API settings are resolved
# dynamically from invitation code validation. That mode is not the default.

# ============================================================================
# Logging Configuration
# ============================================================================
# Options: DEBUG, INFO, WARN, ERROR, NONE
# Use DEBUG for development, WARN for production
EXPO_PUBLIC_LOG_LEVEL=DEBUG
