# ============================================================================
# Subscription Mode Configuration
# ============================================================================
# Options: 'single' or 'multi'
# - single: App is tied to a specific subscription at build time (no invitation URL needed)
# - multi: App supports multiple organizers via invitation URLs (SaaS model)
# Default: multi
EXPO_PUBLIC_SUBSCRIPTION_MODE=multi

# ============================================================================
# Single Subscription Mode Configuration
# ============================================================================
# Required only when SUBSCRIPTION_MODE=single
# When in single-subscription mode, the app is pre-configured for a specific organizer
# and users can directly sign up/login without providing an invitation code.

# Organizer Identification
EXPO_PUBLIC_ORGANIZER_ID=
EXPO_PUBLIC_ORGANIZER_NAME=

# AWS Cognito Configuration
# Dedicated Cognito User Pool for the organizer's riders
EXPO_PUBLIC_AWS_USER_POOL_ID=
EXPO_PUBLIC_AWS_USER_POOL_WEB_CLIENT_ID=
EXPO_PUBLIC_AWS_IDENTITY_POOL_ID=

# API Configuration
# Base URL for the organizer's tour-data-api instance (without trailing slash)
EXPO_PUBLIC_TOUR_DATA_API_BASE_URL=

# ============================================================================
# Multi Subscription Mode Configuration
# ============================================================================
# When SUBSCRIPTION_MODE=multi, the above AWS and API settings are resolved
# dynamically from invitation code validation. They can be left empty or used
# for development/testing with a specific organizer.

# ============================================================================
# Logging Configuration
# ============================================================================
# Options: DEBUG, INFO, WARN, ERROR, NONE
# Use DEBUG for development, WARN for production
EXPO_PUBLIC_LOG_LEVEL=DEBUG
