# ============================================================================
# Tour Rider App — build-time configuration (variable NAMES only)
# ============================================================================
# Store/EAS builds read values ONLY from EAS environment variables:
#   - EAS "preview" environment    -> Test app (com.tourrider.app.dev), Dev backend
#   - EAS "production" environment -> Production app (com.tourrider.app), Prod backend
# The GitHub Actions Deploy workflow writes the backend values into these EAS
# environments from tour-data-api's SSM handover on every run
# (/tour-data-api/<env>/rider/*). Do not set them in EAS by hand.
# See docs/guides/deployment.md (EAS environment sync) for the full matrix.
#
# For local development, copy this file to a git-ignored `.env` and fill in
# Dev values. Never commit a populated `.env`. EXPO_PUBLIC_* values are embedded
# in client builds and must never contain secrets.

# ============================================================================
# App variant (set by eas.json build profiles — do not push to EAS env)
# ============================================================================
# Options: test | production (default: production)
APP_VARIANT=

# ============================================================================
# Subscription Mode Configuration (set by eas.json build profiles)
# ============================================================================
# Options: 'single' (default, recommended) or 'multi' (future SaaS mode)
EXPO_PUBLIC_SUBSCRIPTION_MODE=

# ============================================================================
# Primary backend (preview = Dev values, production = Prod values)
# ============================================================================
# Organizer Identification (optional, labels/logging; same in both environments).
# For store builds, set these in the eas.json build profile `env`, not in EAS.
EXPO_PUBLIC_ORGANIZER_ID=
EXPO_PUBLIC_ORGANIZER_NAME=

# AWS Cognito Configuration (rider pool owned by tour-data-api)
EXPO_PUBLIC_AWS_REGION=
EXPO_PUBLIC_AWS_USER_POOL_ID=
EXPO_PUBLIC_AWS_USER_POOL_WEB_CLIENT_ID=
# Optional; tour-data-api has no identity pool, so leave it empty.
EXPO_PUBLIC_AWS_IDENTITY_POOL_ID=

# Base URL for the organizer's tour-data-api instance (without trailing slash)
EXPO_PUBLIC_TOUR_DATA_API_BASE_URL=

# ============================================================================
# Store-reviewer routing (production environment ONLY; leave unset in preview)
# ============================================================================
# When the reviewer email signs in, the Production app switches to the Dev
# backend below. If EXPO_PUBLIC_REVIEW_USERNAME or any required REVIEW value is
# empty, routing is disabled (fail-safe). In store builds the Deploy workflow
# sets these in `production` only: Dev values from SSM, and the username from
# the GitHub variable REVIEW_USERNAME.
EXPO_PUBLIC_REVIEW_USERNAME=
EXPO_PUBLIC_REVIEW_AWS_REGION=
EXPO_PUBLIC_REVIEW_AWS_USER_POOL_ID=
EXPO_PUBLIC_REVIEW_AWS_USER_POOL_WEB_CLIENT_ID=
EXPO_PUBLIC_REVIEW_AWS_IDENTITY_POOL_ID=
EXPO_PUBLIC_REVIEW_TOUR_DATA_API_BASE_URL=

# ============================================================================
# Logging (set by eas.json build profiles)
# ============================================================================
# Options: DEBUG, INFO, WARN, ERROR, NONE
EXPO_PUBLIC_LOG_LEVEL=
# Log GET request details (true|false)
EXPO_PUBLIC_API_DEBUG_GET=

# ============================================================================
# Android Firebase config (EAS FILE variable, secret visibility — not in .env)
# ============================================================================
# preview: google-services.json for com.tourrider.app.dev
# production: google-services.json for com.tourrider.app
# GOOGLE_SERVICES_JSON=
