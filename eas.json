{
  "cli": {
    "version": ">= 12.0.0",
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "environment": "development",
      "env": {
        "APP_VARIANT": "test",
        "EXPO_PUBLIC_SUBSCRIPTION_MODE": "single",
        "EXPO_PUBLIC_LOG_LEVEL": "DEBUG"
      }
    },
    "test": {
      "distribution": "store",
      "channel": "test",
      "environment": "preview",
      "autoIncrement": true,
      "env": {
        "APP_VARIANT": "test",
        "EXPO_PUBLIC_SUBSCRIPTION_MODE": "single",
        "EXPO_PUBLIC_LOG_LEVEL": "WARN",
        "EXPO_PUBLIC_API_DEBUG_GET": "false"
      }
    },
    "adhoc": {
      "extends": "test",
      "distribution": "internal"
    },
    "production": {
      "distribution": "store",
      "channel": "production",
      "environment": "production",
      "autoIncrement": true,
      "env": {
        "APP_VARIANT": "production",
        "EXPO_PUBLIC_SUBSCRIPTION_MODE": "single",
        "EXPO_PUBLIC_LOG_LEVEL": "WARN",
        "EXPO_PUBLIC_API_DEBUG_GET": "false"
      }
    }
  },
  "submit": {
    "test": {
      "ios": {
        "ascAppId": "<ASC_APP_ID_DEV>"
      },
      "android": {
        "track": "internal",
        "releaseStatus": "completed"
      }
    },
    "production": {
      "ios": {
        "ascAppId": "<ASC_APP_ID_PROD>"
      },
      "android": {
        "track": "alpha",
        "releaseStatus": "completed"
      }
    }
  }
}
